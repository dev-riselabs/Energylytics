# Static SPA (Vite build) - no Node/Passenger app runs here.
# If Plesk re-enables Passenger for this folder, this neutralizes it.
<IfModule mod_passenger.c>
  PassengerEnabled off
</IfModule>

# SPA fallback: rewrite unknown paths to index.html so React Router
# can handle client-side navigation on hard reloads and deep links.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories as-is (assets, /index.html, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html
  RewriteRule . /index.html [L]
</IfModule>

# Caching: long-cache hashed build assets, never cache the HTML entry point.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|otf|eot|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>